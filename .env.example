# Optional LLM backend. The pipeline has a deterministic fallback when unset.
VIRELION_LLM_BASE_URL=https://api.openai.com/v1
VIRELION_LLM_API_KEY=
VIRELION_LLM_MODEL=gpt-5

# Optional report distribution.
VIRELION_SMTP_HOST=smtp.office365.com
VIRELION_SMTP_PORT=587
VIRELION_SMTP_USER=
VIRELION_SMTP_PASS=
VIRELION_ALERT_TO=
