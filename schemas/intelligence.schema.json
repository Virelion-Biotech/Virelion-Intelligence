{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Virelion-Biotech/Virelion-Intelligence/blob/main/schemas/intelligence.schema.json",
  "title": "Virelion Intelligence Record",
  "type": "object",
  "required": ["record_type", "record_id", "schema_version"],
  "properties": {
    "record_type": {"type": "string", "enum": ["source", "claim", "evidence", "dataset", "opportunity", "run"]},
    "record_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "0.1"}
  },
  "additionalProperties": true
}
